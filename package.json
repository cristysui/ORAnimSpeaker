{
  "name": "or-animspeaker",
  "version": "1.0.0",
  "private": true,
  "description": "ORAnimSpeaker voice character animation editor",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/web",
    "packages/core",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npx pnpm --filter @or-animspeaker/web dev",
    "dev:web": "npx pnpm --filter @or-animspeaker/web dev",
    "build": "npx pnpm build:wasm && npx pnpm --filter @or-animspeaker/web build",
    "build:web": "npx pnpm --filter @or-animspeaker/web build",
    "build:wasm": "npx pnpm --filter @openreel/core build:wasm",
    "preview": "npx pnpm --filter @or-animspeaker/web preview",
    "test": "npx pnpm -r test:run",
    "typecheck": "npx pnpm -r typecheck",
    "lint": "npx pnpm -r lint",
    "clean": "npx pnpm -r clean"
  }
}
